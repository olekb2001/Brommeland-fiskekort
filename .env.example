# Kopier denne filen til .env.local og fyll inn verdiene.

# Offentlig adresse til nettstedet (brukes i lenker, QR-koder og Stripe-redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...
# Fra `stripe listen` lokalt, eller fra webhook-oppsettet i Stripe Dashboard i produksjon
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend for e-post (https://resend.com). Domenet i MAIL_FROM må være verifisert i Resend.
RESEND_API_KEY=re_...
MAIL_FROM="Brommeland <fiskekort@dittdomene.no>"
# Valgfritt: kopi av hver ordre sendes hit
ORDER_NOTIFY_EMAIL=

# Upstash Redis (lagrer tilgjengelighet og fiskekort). Legg til via Vercel Marketplace eller upstash.com.
# Uten disse brukes en midlertidig minnelagring i utvikling (nullstilles ved restart).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Adminside på /admin (sperre datoer, se bestillinger). Velg et langt passord.
ADMIN_PASSWORD=
# Valgfri. Brukes til å signere innloggingen. Hvis tom brukes ADMIN_PASSWORD.
ADMIN_SECRET=
